{
  "name": "school-information-system",
  "version": "1.0.0",
  "description": "Professional School Information System with Admin Dashboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:seed": "node data/seed.js",
    "db:reset": "node -e \"import('fs').then(fs => { if (fs.existsSync('data/db.json')) fs.unlinkSync('data/db.json'); })\" && node data/seed.js",
    "test": "node data/test-migration.js && node data/test-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide": "^0.460.0",
    "memorystore": "^1.6.7",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "slug": "^9.1.0",
    "zod": "^3.23.8"
  }
}
