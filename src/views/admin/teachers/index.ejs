<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola data guru pengajar, kepala sekolah, dan jabatan kependidikan.</p>
      </div>
      <div class="mt-3 mt-md-0 d-flex gap-2">
        <a href="/admin/teachers/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
          <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
          <span>Tambah Guru Baru</span>
        </a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <form action="/admin/teachers" method="GET" class="d-flex gap-2 align-items-center" style="max-width: 320px;">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari nama atau mapel..." value="<%= search %>">
          <button class="btn btn-sm btn-outline-secondary" type="submit">
            <i data-lucide="search" style="width: 14px; height: 14px;"></i>
          </button>
        </form>
      </div>

      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Nama Guru</th>
              <th>Jabatan / Posisi</th>
              <th>Mata Pelajaran</th>
              <th>NIP</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (teachers && teachers.length > 0) { %>
              <% teachers.forEach(function(teacher) { %>
                <tr>
                  <td style="width: 60px;">
                    <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: #e2e8f0;">
                      <img src="<%= teacher.photo || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= teacher.name %></div>
                    <% if (teacher.isHeadmaster) { %>
                      <span class="badge bg-warning text-dark small">Kepala Sekolah</span>
                    <% } %>
                  </td>
                  <td class="small"><%= teacher.position %></td>
                  <td class="small fw-semibold text-primary"><%= teacher.subject || '-' %></td>
                  <td class="small text-muted font-monospace"><%= teacher.nip || '-' %></td>
                  <td>
                    <span class="status-badge <%= teacher.isActive ? 'active' : 'inactive' %>">
                      <%= teacher.isActive ? 'Aktif' : 'Nonaktif' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/teachers/<%= teacher.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/teachers/<%= teacher.id %>/delete" method="POST" onsubmit="return confirm('Hapus data guru ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">Belum ada data guru.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
