<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Detail Pendaftar PPDB</h3>
        <p class="text-muted small mb-0">Nomor Registrasi: <strong class="text-primary"><%= applicant.registrationNo %></strong></p>
      </div>
      <a href="/admin/ppdb" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <div class="row g-4">
      <!-- Data Biodata Siswa & Dokumen -->
      <div class="col-lg-8">
        <div class="admin-card mb-4">
          <div class="admin-card-header">
            <h5>1. Biodata Calon Siswa</h5>
          </div>
          <div class="admin-card-body">
            <div class="row g-3">
              <div class="col-sm-6">
                <small class="text-muted d-block">Nama Lengkap</small>
                <div class="fw-bold fs-6"><%= applicant.fullName %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Jenis Kelamin</small>
                <div><%= applicant.gender %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Tempat & Tanggal Lahir</small>
                <div><%= applicant.birthPlace || '-' %>, <%= formatDate(applicant.birthDate) %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Asal Sekolah (SMP/MTs)</small>
                <div class="fw-semibold text-primary"><%= applicant.originSchool || '-' %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Pilihan Program Peminatan</small>
                <div class="badge bg-light text-dark fs-6"><%= applicant.programChoice || '-' %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Waktu Mendaftar</small>
                <div><%= formatDate(applicant.createdAt) %></div>
              </div>
              <div class="col-12">
                <small class="text-muted d-block">Alamat Tempat Tinggal</small>
                <div><%= applicant.address || '-' %></div>
              </div>
            </div>
          </div>
        </div>

        <div class="admin-card mb-4">
          <div class="admin-card-header">
            <h5>2. Data Orang Tua / Wali</h5>
          </div>
          <div class="admin-card-body">
            <div class="row g-3">
              <div class="col-sm-6">
                <small class="text-muted d-block">Nama Orang Tua / Wali</small>
                <div class="fw-bold"><%= applicant.parentName %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Nomor Telepon / WhatsApp</small>
                <div class="fw-bold text-success"><%= applicant.parentPhone %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted d-block">Email Orang Tua</small>
                <div><%= applicant.parentEmail || '-' %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Berkas Lampiran Dokumen -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h5>3. Berkas Persyaratan Terunggah</h5>
          </div>
          <div class="admin-card-body">
            <% if (applicant.documentUrl) { %>
              <div class="p-3 bg-light border rounded d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                  <i data-lucide="file-check" style="width: 28px; height: 28px; color: var(--admin-primary);"></i>
                  <div>
                    <strong>Berkas Dokumen Calon Siswa</strong>
                    <div class="small text-muted">Lampiran PDF / Berkas Persyaratan Pendaftaran</div>
                  </div>
                </div>
                <a href="<%= applicant.documentUrl %>" target="_blank" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                  <span>Lihat / Unduh Dokumen</span>
                </a>
              </div>
            <% } else { %>
              <div class="text-muted small">Pendaftar tidak mengunggah berkas digital.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Action Panel Verifikasi -->
      <div class="col-lg-4">
        <div class="admin-card">
          <div class="admin-card-header">
            <h5>Tindak Lanjut & Verifikasi</h5>
          </div>
          <div class="admin-card-body">
            <form action="/admin/ppdb/<%= applicant.id %>/status" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="mb-3">
                <label class="form-label">Status Pendaftaran</label>
                <select name="status" class="form-select">
                  <option value="pending" <%= applicant.status === 'pending' ? 'selected' : '' %>>Menunggu Verifikasi (Pending)</option>
                  <option value="verified" <%= applicant.status === 'verified' ? 'selected' : '' %>>Berkas Terverifikasi (Verified)</option>
                  <option value="accepted" <%= applicant.status === 'accepted' ? 'selected' : '' %>>DITERIMA / LOLOS SELEKSI</option>
                  <option value="rejected" <%= applicant.status === 'rejected' ? 'selected' : '' %>>DITOLAK / TIDAK LOLOS</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Catatan Panitia Seleksi</label>
                <textarea name="notes" rows="4" class="form-control" placeholder="Tuliskan catatan khusus atau alasan status..."><%= applicant.notes || '' %></textarea>
                <div class="form-text">Catatan ini dapat dibaca oleh siswa saat mengecek status.</div>
              </div>

              <button type="submit" class="btn btn-primary w-100 mb-3 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i>
                <span>Perbarui Status Pendaftar</span>
              </button>
            </form>

            <form action="/admin/ppdb/<%= applicant.id %>/delete" method="POST" onsubmit="return confirm('Hapus permanen data pendaftar ini?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                Hapus Data Pendaftar
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
