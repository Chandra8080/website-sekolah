<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola dan verifikasi data calon peserta didik baru yang masuk.</p>
      </div>
      <div class="mt-3 mt-md-0 d-flex gap-2">
        <a href="/admin/ppdb/settings" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
          <i data-lucide="sliders" style="width: 14px; height: 14px;"></i>
          <span>Pengaturan PPDB</span>
        </a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <form action="/admin/ppdb" method="GET" class="d-flex flex-wrap gap-2 align-items-center w-100">
          <div class="input-group input-group-sm" style="max-width: 280px;">
            <input type="text" name="search" class="form-control" placeholder="Cari nama atau No. Reg..." value="<%= search %>">
            <button class="btn btn-outline-secondary" type="submit">
              <i data-lucide="search" style="width: 14px; height: 14px;"></i>
            </button>
          </div>

          <select name="status" class="form-select form-select-sm" style="max-width: 180px;" onchange="this.form.submit()">
            <option value="">Semua Status</option>
            <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Menunggu Verifikasi</option>
            <option value="verified" <%= status === 'verified' ? 'selected' : '' %>>Terverifikasi</option>
            <option value="accepted" <%= status === 'accepted' ? 'selected' : '' %>>Diterima (Lolos)</option>
            <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Ditolak</option>
          </select>

          <% if (search || status) { %>
            <a href="/admin/ppdb" class="btn btn-sm btn-outline-danger">Reset Filter</a>
          <% } %>
        </form>
      </div>

      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>No. Registrasi</th>
              <th>Nama Lengkap</th>
              <th>Asal Sekolah</th>
              <th>Peminatan</th>
              <th>Kontak Ortu</th>
              <th>Status</th>
              <th>Tanggal Daftar</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (applicants && applicants.length > 0) { %>
              <% applicants.forEach(function(app) { %>
                <tr>
                  <td class="fw-bold text-primary small"><%= app.registrationNo %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= app.fullName %></div>
                    <small class="text-muted"><%= app.gender %></small>
                  </td>
                  <td class="small"><%= app.originSchool || '-' %></td>
                  <td><span class="badge bg-light text-dark"><%= app.programChoice || '-' %></span></td>
                  <td>
                    <div class="small fw-semibold"><%= app.parentName %></div>
                    <small class="text-muted"><%= app.parentPhone %></small>
                  </td>
                  <td>
                    <span class="status-badge <%= app.status %>">
                      <%= app.status %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= formatDate(app.createdAt) %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/ppdb/<%= app.id %>" class="btn-action" title="Detail & Verifikasi"><i data-lucide="eye" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/ppdb/<%= app.id %>/delete" method="POST" onsubmit="return confirm('Hapus data pendaftar ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">Belum ada data pendaftar yang cocok.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
