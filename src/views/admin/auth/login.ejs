<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk Panel Admin | <%= settings.school_name || 'Sekolah' %></title>
  
  <% if (settings.school_favicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= settings.school_favicon %>">
  <% } %>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0b1a30;
      color: #334155;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .login-card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 440px;
      overflow: hidden;
    }
    .login-header {
      background: #0f2447;
      color: #ffffff;
      padding: 36px 30px 30px 30px;
      text-align: center;
      border-bottom: 3px solid #c8a84b;
    }
    .login-body {
      padding: 36px 30px;
    }
    .form-control {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.95rem;
    }
    .form-control:focus {
      border-color: #1a3a6b;
      box-shadow: 0 0 0 3px rgba(26, 58, 107, 0.15);
    }
    .btn-login {
      background-color: #1a3a6b;
      color: #ffffff;
      font-weight: 600;
      padding: 12px;
      border-radius: 8px;
      width: 100%;
      border: none;
      transition: all 0.2s;
    }
    .btn-login:hover {
      background-color: #0f2447;
      color: #ffffff;
    }
  </style>
</head>
<body>

<div class="login-card">
  <div class="login-header">
    <div style="width: 48px; height: 48px; border-radius: 10px; background: #c8a84b; color: #0b1a30; font-weight: 800; font-size: 1.4rem; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
      SIS
    </div>
    <h4 class="fw-bold mb-1"><%= settings.school_name || 'SMA Negeri Nusantara' %></h4>
    <p class="text-white-50 small mb-0">Sistem Informasi Sekolah & Panel Administrasi</p>
  </div>

  <div class="login-body">
    <!-- Alert Flash Messages -->
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="alert alert-danger py-2 px-3 small mb-4" role="alert">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="alert alert-success py-2 px-3 small mb-4" role="alert">
        <%= success %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label fw-semibold small">Nama Pengguna atau Email</label>
        <input type="text" name="username" class="form-control" placeholder="admin@sekolah.sch.id" required autofocus>
      </div>

      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="form-label fw-semibold small mb-0">Kata Sandi</label>
        </div>
        <input type="password" name="password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required>
      </div>

      <button type="submit" class="btn btn-login">
        Masuk ke Sistem
      </button>
    </form>

    <div class="text-center mt-4 pt-3 border-top">
      <a href="/" class="text-muted small text-decoration-none">&larr; Kembali ke Website Utama</a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
