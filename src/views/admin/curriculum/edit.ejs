<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Edit Kurikulum</h3>
        <p class="text-muted small mb-0"><%= item.name %></p>
      </div>
      <a href="/admin/curriculum" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/curriculum/<%= item.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Kurikulum</h5>
            </div>
            <div class="admin-card-body">
              <div class="row g-3 mb-3">
                <div class="col-md-8">
                  <label class="form-label">Nama Kurikulum <span class="text-danger">*</span></label>
                  <input type="text" name="name" class="form-control" value="<%= item.name %>" required>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Tahun Ajaran <span class="text-danger">*</span></label>
                  <input type="text" name="year" class="form-control" value="<%= item.year %>" required>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Berkas Silabus Saat Ini</label>
                <% if (item.fileUrl) { %>
                  <div class="mb-2 small">
                    <a href="<%= item.fileUrl %>" target="_blank" class="text-primary fw-bold">Lihat Dokumen Silabus Terunggah</a>
                  </div>
                <% } %>
                <input type="file" name="file" class="form-control" accept=".pdf,.doc,.docx">
                <div class="form-text">Biarkan kosong jika tidak mengubah berkas.</div>
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi & Struktur</label>
                <textarea name="description" rows="6" class="form-control"><%= item.description %></textarea>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" <%= item.isActive ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="activeSwitch">Status Kurikulum Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
