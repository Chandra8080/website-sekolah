<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Tenaga Kependidikan</h3>
        <p class="text-muted small mb-0">Lengkapi data staf tata usaha atau teknisi sekolah.</p>
      </div>
      <a href="/admin/staff" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/staff" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Identitas Staf</h5>
            </div>
            <div class="admin-card-body">
              <div class="row g-3 mb-3">
                <div class="col-md-7">
                  <label class="form-label">Nama Lengkap & Gelar <span class="text-danger">*</span></label>
                  <input type="text" name="name" class="form-control" placeholder="Contoh: Sulaeman, S.AP." required>
                </div>
                <div class="col-md-5">
                  <label class="form-label">NIP</label>
                  <input type="text" name="nip" class="form-control" placeholder="1985xxxx xxxxx x xxx">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Jabatan</label>
                  <input type="text" name="position" class="form-control" placeholder="Kepala Tata Usaha / Bendahara" value="Staf Tata Usaha">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Departemen / Bagian</label>
                  <input type="text" name="department" class="form-control" placeholder="Administrasi Siswa / Kepegawaian" value="Tata Usaha">
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Keterangan / Bio</label>
                <textarea name="bio" rows="3" class="form-control"></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Foto & Status</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Foto Profil Formal</label>
                <input type="file" name="photo" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" checked>
                <label class="form-check-label fw-bold small" for="activeSwitch">Status Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Data Staf</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
