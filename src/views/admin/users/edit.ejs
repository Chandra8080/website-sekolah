<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Edit Akun Pengguna</h3>
        <p class="text-muted small mb-0"><%= item.name %> (@<%= item.username %>)</p>
      </div>
      <a href="/admin/users" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/users/<%= item.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Akun</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Nama Lengkap <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" value="<%= item.name %>" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Alamat Email <span class="text-danger">*</span></label>
                  <input type="email" name="email" class="form-control" value="<%= item.email %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Username <span class="text-danger">*</span></label>
                  <input type="text" name="username" class="form-control" value="<%= item.username %>" required>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Ubah Kata Sandi (Opsional)</label>
                  <input type="password" name="password" class="form-control" placeholder="Biarkan kosong jika tidak diubah" minlength="6">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Peran Akses (Role) <span class="text-danger">*</span></label>
                  <select name="roleId" class="form-select" required>
                    <% roles.forEach(function(r) { %>
                      <option value="<%= r.id %>" <%= item.roleId === r.id ? 'selected' : '' %>><%= r.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Avatar Profil Saat Ini</label>
                <% if (item.avatar) { %>
                  <div class="mb-2"><img src="<%= item.avatar %>" alt="" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;"></div>
                <% } %>
                <input type="file" name="avatar" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" <%= item.isActive ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="activeSwitch">Akun Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
