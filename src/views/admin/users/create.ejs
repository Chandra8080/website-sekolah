<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Pengguna Baru</h3>
        <p class="text-muted small mb-0">Buat akun untuk staf atau operator sistem.</p>
      </div>
      <a href="/admin/users" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/users" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Akun</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Nama Lengkap <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="Nama staf" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Alamat Email <span class="text-danger">*</span></label>
                  <input type="email" name="email" class="form-control" placeholder="staf@sekolah.sch.id" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Username <span class="text-danger">*</span></label>
                  <input type="text" name="username" class="form-control" placeholder="staf_admin" required>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Kata Sandi (Password) <span class="text-danger">*</span></label>
                  <input type="password" name="password" class="form-control" placeholder="Minimal 6 karakter" minlength="6" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Peran Akses (Role) <span class="text-danger">*</span></label>
                  <select name="roleId" class="form-select" required>
                    <option value="">-- Pilih Peran --</option>
                    <% roles.forEach(function(r) { %>
                      <option value="<%= r.id %>"><%= r.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Foto Profil / Avatar</label>
                <input type="file" name="avatar" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" checked>
                <label class="form-check-label fw-bold small" for="activeSwitch">Akun Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Pengguna</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
