<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola hierarki pimpinan dan pejabat struktur organisasi sekolah.</p>
      </div>
      <a href="/admin/org-structure/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        <span>Tambah Pejabat</span>
      </a>
    </div>

    <div class="admin-card">
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Nama Pejabat</th>
              <th>Jabatan</th>
              <th>Tingkat Hierarki</th>
              <th>Urutan</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (structures && structures.length > 0) { %>
              <% structures.forEach(function(s) { %>
                <tr>
                  <td style="width: 60px;">
                    <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: #e2e8f0;">
                      <img src="<%= s.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                  </td>
                  <td class="fw-bold text-dark"><%= s.name %></td>
                  <td class="small fw-semibold text-primary"><%= s.position %></td>
                  <td><span class="badge bg-light text-dark">Level <%= s.level %></span></td>
                  <td class="small text-muted"><%= s.sortOrder %></td>
                  <td>
                    <span class="status-badge <%= s.isActive ? 'active' : 'inactive' %>">
                      <%= s.isActive ? 'Aktif' : 'Nonaktif' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/org-structure/<%= s.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/org-structure/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Hapus data pejabat ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">Belum ada struktur organisasi.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
