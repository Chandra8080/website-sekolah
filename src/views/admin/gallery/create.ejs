<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Unggah Foto Galeri</h3>
        <p class="text-muted small mb-0">Tambahkan dokumentasi foto kegiatan sekolah.</p>
      </div>
      <a href="/admin/gallery" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Galeri</a>
    </div>

    <form action="/admin/gallery" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Foto</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul / Keterangan Foto</label>
                <input type="text" name="title" class="form-control" placeholder="Contoh: Upacara Bendera HUT Kemerdekaan RI">
              </div>

              <div class="mb-3">
                <label class="form-label">Kategori Album</label>
                <select name="categoryId" class="form-select">
                  <option value="">-- Pilih Kategori --</option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi Tambahan</label>
                <textarea name="description" rows="3" class="form-control" placeholder="Catatan singkat tentang foto atau momen ini..."></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Pilih Berkas Foto <span class="text-danger">*</span></label>
                <input type="file" name="photos" class="form-control" accept="image/*" multiple required>
                <div class="form-text">Dapat memilih lebih dari satu foto sekaligus (format JPG/PNG/WEBP).</div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" checked>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan ke Galeri Publik</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="upload" style="width: 16px; height: 16px;"></i>
                <span>Unggah Foto Sekarang</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
