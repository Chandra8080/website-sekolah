<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Edit Foto Galeri</h3>
        <p class="text-muted small mb-0"><%= item.title %></p>
      </div>
      <a href="/admin/gallery" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Galeri</a>
    </div>

    <form action="/admin/gallery/<%= item.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Foto</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3 text-center">
                <img src="<%= item.imageUrl %>" alt="" class="rounded shadow-sm" style="max-height: 220px; object-fit: contain;">
              </div>

              <div class="mb-3">
                <label class="form-label">Judul Foto <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" value="<%= item.title %>" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Kategori Album</label>
                <select name="categoryId" class="form-select">
                  <option value="">-- Tanpa Kategori --</option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>" <%= item.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi Foto</label>
                <textarea name="description" rows="3" class="form-control"><%= item.description || '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Ganti Berkas Foto (Opsional)</label>
                <input type="file" name="photo" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" <%= item.isPublished ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan di Publik</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
