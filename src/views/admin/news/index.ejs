<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola artikel warta sekolah, rilis pers, dan informasi berita.</p>
      </div>
      <div class="mt-3 mt-md-0 d-flex gap-2">
        <a href="/admin/news/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
          <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
          <span>Tambah Berita</span>
        </a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <form action="/admin/news" method="GET" class="d-flex flex-wrap gap-2 align-items-center w-100">
          <div class="input-group input-group-sm" style="max-width: 280px;">
            <input type="text" name="search" class="form-control" placeholder="Cari judul..." value="<%= search %>">
            <button class="btn btn-outline-secondary" type="submit">
              <i data-lucide="search" style="width: 14px; height: 14px;"></i>
            </button>
          </div>
          <select name="categoryId" class="form-select form-select-sm" style="max-width: 200px;" onchange="this.form.submit()">
            <option value="">Semua Kategori</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>" <%= categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
          <% if (search || categoryId) { %>
            <a href="/admin/news" class="btn btn-sm btn-outline-danger">Reset</a>
          <% } %>
        </form>
      </div>

      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Gambar</th>
              <th>Judul Berita</th>
              <th>Kategori</th>
              <th>Status</th>
              <th>Penulis</th>
              <th>Waktu</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (newsList && newsList.length > 0) { %>
              <% newsList.forEach(function(item) { %>
                <tr>
                  <td style="width: 70px;">
                    <div style="width: 60px; height: 42px; border-radius: 6px; overflow: hidden; background: #e2e8f0;">
                      <img src="<%= item.imageUrl || 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.title %></div>
                    <small class="text-muted"><%= item.slug %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-primary"><%= item.category ? item.category.name : 'Umum' %></span>
                  </td>
                  <td>
                    <span class="status-badge <%= item.isPublished ? 'published' : 'draft' %>">
                      <%= item.isPublished ? 'Terbit' : 'Draf' %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= item.author || 'Admin' %></td>
                  <td class="small text-muted"><%= formatDate(item.publishedAt || item.createdAt) %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/news/<%= item.slug %>" target="_blank" class="btn-action" title="Lihat"><i data-lucide="eye" style="width: 14px; height: 14px;"></i></a>
                      <a href="/admin/news/<%= item.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/news/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berita ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">Belum ada berita yang tersedia.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
