<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Edit Berita</h3>
        <p class="text-muted small mb-0"><%= item.title %></p>
      </div>
      <a href="/admin/news" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/news/<%= item.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Sunting Konten Berita</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Berita <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" value="<%= item.title %>" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Ringkasan (Excerpt)</label>
                <textarea name="excerpt" rows="3" class="form-control"><%= item.excerpt %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Isi Lengkap Berita <span class="text-danger">*</span></label>
                <textarea name="content" rows="12" class="form-control" required><%= item.content %></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Pengaturan Publikasi</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Kategori Berita</label>
                <select name="categoryId" class="form-select">
                  <option value="">-- Tanpa Kategori --</option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>" <%= item.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Gambar Utama Saat Ini</label>
                <% if (item.imageUrl) { %>
                  <div class="mb-2 rounded overflow-hidden" style="max-height: 160px;">
                    <img src="<%= item.imageUrl %>" alt="" class="w-100 h-100" style="object-fit: cover;">
                  </div>
                <% } %>
                <input type="file" name="image" class="form-control" accept="image/*">
                <div class="form-text">Biarkan kosong jika tidak ingin mengubah gambar.</div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" <%= item.isPublished ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan Berita</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
