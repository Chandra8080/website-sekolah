<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Berita Baru</h3>
        <p class="text-muted small mb-0">Publikasikan informasi dan artikel terkini untuk portal sekolah.</p>
      </div>
      <a href="/admin/news" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/news" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Konten Utama Berita</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Berita <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="Tuliskan judul berita yang informatif" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Ringkasan / Kutipan (Excerpt)</label>
                <textarea name="excerpt" rows="3" class="form-control" placeholder="Ringkasan 1-2 kalimat untuk preview kartu berita..."></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Isi Lengkap Berita <span class="text-danger">*</span></label>
                <textarea name="content" rows="12" class="form-control" placeholder="Tuliskan isi berita lengkap di sini (mendukung format HTML/teks)..." required></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Publikasi & Taksonomi</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Kategori Berita</label>
                <select name="categoryId" class="form-select">
                  <option value="">-- Pilih Kategori --</option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Gambar Utama (Sampul)</label>
                <input type="file" name="image" class="form-control" accept="image/*">
                <div class="form-text">Format: JPG, PNG, WEBP (Maksimal 10MB)</div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" checked>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan Langsung ke Publik</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan & Terbitkan Berita</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
