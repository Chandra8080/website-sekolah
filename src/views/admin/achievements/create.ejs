<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Prestasi Baru</h3>
        <p class="text-muted small mb-0">Dokumentasikan pencapaian kejuaraan sekolah.</p>
      </div>
      <a href="/admin/achievements" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/achievements" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Prestasi</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Nama Kejuaraan / Prestasi <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="Contoh: Juara 1 Olimpiade Sains Nasional (OSN) Bidang Fisika" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-4">
                  <label class="form-label">Kategori</label>
                  <select name="category" class="form-select">
                    <option value="akademik">Akademik</option>
                    <option value="non-akademik">Non-Akademik (Seni/Olahraga)</option>
                    <option value="guru">Prestasi Guru</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Tingkat Lomba</label>
                  <select name="level" class="form-select">
                    <option value="kabupaten/kota">Kabupaten / Kota</option>
                    <option value="provinsi">Provinsi</option>
                    <option value="nasional" selected>Nasional</option>
                    <option value="internasional">Internasional</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Tahun Perolehan</label>
                  <input type="text" name="year" class="form-control" value="<%= new Date().getFullYear() %>">
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Rincian & Nama Siswa / Tim</label>
                <textarea name="description" rows="5" class="form-control" placeholder="Tuliskan nama peraih medali, penyelenggara lomba, dan keterangan lainnya..."></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Dokumentasi Foto</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Foto Penyerahan Piala / Piagam</label>
                <input type="file" name="image" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" checked>
                <label class="form-check-label fw-bold small" for="publishSwitch">Tampilkan di Publik</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Prestasi</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
