<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola catatan torehan prestasi siswa dan guru.</p>
      </div>
      <a href="/admin/achievements/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        <span>Tambah Prestasi</span>
      </a>
    </div>

    <div class="admin-card">
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Nama Prestasi / Juara</th>
              <th>Kategori</th>
              <th>Tingkat</th>
              <th>Tahun</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (achievements && achievements.length > 0) { %>
              <% achievements.forEach(function(ach) { %>
                <tr>
                  <td style="width: 60px;">
                    <div style="width: 50px; height: 40px; border-radius: 6px; overflow: hidden; background: #e2e8f0;">
                      <img src="<%= ach.imageUrl || 'https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= ach.title %></div>
                    <small class="text-muted"><%= truncate(ach.description, 50) %></small>
                  </td>
                  <td><span class="badge bg-light text-primary text-uppercase"><%= ach.category %></span></td>
                  <td><span class="badge bg-warning text-dark text-uppercase"><%= ach.level %></span></td>
                  <td class="small fw-semibold"><%= ach.year || '-' %></td>
                  <td>
                    <span class="status-badge <%= ach.isPublished ? 'published' : 'draft' %>">
                      <%= ach.isPublished ? 'Terbit' : 'Draf' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/achievements/<%= ach.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/achievements/<%= ach.id %>/delete" method="POST" onsubmit="return confirm('Hapus prestasi ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">Belum ada data prestasi tercatat.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
