<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Edit Pengumuman</h3>
        <p class="text-muted small mb-0"><%= item.title %></p>
      </div>
      <a href="/admin/announcements" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/announcements/<%= item.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Isi Pengumuman</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Pengumuman <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" value="<%= item.title %>" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Konten Pengumuman <span class="text-danger">*</span></label>
                <textarea name="content" rows="10" class="form-control" required><%= item.content %></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Pengaturan & Lampiran</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Kategori</label>
                <select name="category" class="form-select">
                  <option value="umum" <%= item.category === 'umum' ? 'selected' : '' %>>Umum</option>
                  <option value="akademik" <%= item.category === 'akademik' ? 'selected' : '' %>>Akademik</option>
                  <option value="kesiswaan" <%= item.category === 'kesiswaan' ? 'selected' : '' %>>Kesiswaan</option>
                  <option value="kepegawaian" <%= item.category === 'kepegawaian' ? 'selected' : '' %>>Kepegawaian</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Tingkat Prioritas</label>
                <select name="priority" class="form-select">
                  <option value="normal" <%= item.priority === 'normal' ? 'selected' : '' %>>Normal</option>
                  <option value="high" <%= item.priority === 'high' ? 'selected' : '' %>>Penting (High)</option>
                  <option value="urgent" <%= item.priority === 'urgent' ? 'selected' : '' %>>Mendesak (Urgent)</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Lampiran Berkas Saat Ini</label>
                <% if (item.attachmentUrl) { %>
                  <div class="mb-2 small">
                    <a href="<%= item.attachmentUrl %>" target="_blank" class="text-primary fw-bold">Lihat Berkas Terlampir</a>
                  </div>
                <% } %>
                <input type="file" name="attachment" class="form-control" accept=".pdf,.doc,.docx">
                <div class="form-text">Biarkan kosong jika tidak mengganti berkas.</div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" <%= item.isPublished ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan Pengumuman</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
