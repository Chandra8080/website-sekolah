<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Agenda Kegiatan</h3>
        <p class="text-muted small mb-0">Jadwalkan acara, seminar, atau ujian sekolah.</p>
      </div>
      <a href="/admin/events" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/events" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Detail Agenda</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Agenda Kegiatan <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="Contoh: Peringatan Hari Pendidikan Nasional" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Tanggal Mulai <span class="text-danger">*</span></label>
                  <input type="date" name="startDate" class="form-control" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Tanggal Selesai (Opsional)</label>
                  <input type="date" name="endDate" class="form-control">
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Waktu Mulai</label>
                  <input type="time" name="startTime" class="form-control" value="08:00">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Waktu Selesai</label>
                  <input type="time" name="endTime" class="form-control" value="12:00">
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Lokasi / Tempat Pelaksanaan</label>
                <input type="text" name="location" class="form-control" placeholder="Aula Utama Sekolah / Lapangan Upacara" value="Kampus Sekolah">
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi Lengkap Kegiatan</label>
                <textarea name="description" rows="8" class="form-control" placeholder="Rincian acara, susunan agenda, atau instruksi peserta..."></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Status & Foto</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Status Acara</label>
                <select name="status" class="form-select">
                  <option value="upcoming">Akan Datang (Upcoming)</option>
                  <option value="ongoing">Sedang Berlangsung</option>
                  <option value="completed">Selesai</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label">Poster / Foto Banner</label>
                <input type="file" name="image" class="form-control" accept="image/*">
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isPublished" value="true" id="publishSwitch" checked>
                <label class="form-check-label fw-bold small" for="publishSwitch">Terbitkan ke Publik</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Agenda</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
