<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola jadwal dan agenda kegiatan sekolah.</p>
      </div>
      <a href="/admin/events/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        <span>Tambah Agenda</span>
      </a>
    </div>

    <div class="admin-card">
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Judul Agenda</th>
              <th>Tanggal Pelaksanaan</th>
              <th>Waktu</th>
              <th>Lokasi</th>
              <th>Status</th>
              <th>Publikasi</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (events && events.length > 0) { %>
              <% events.forEach(function(event) { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= event.title %></div>
                    <small class="text-muted"><%= event.slug %></small>
                  </td>
                  <td class="small fw-semibold text-primary"><%= formatDate(event.startDate) %></td>
                  <td class="small text-muted"><%= event.startTime || '08:00' %> - <%= event.endTime || 'Selesai' %></td>
                  <td class="small"><%= event.location || 'Kampus Sekolah' %></td>
                  <td>
                    <span class="badge bg-light text-dark text-uppercase small"><%= event.status %></span>
                  </td>
                  <td>
                    <span class="status-badge <%= event.isPublished ? 'published' : 'draft' %>">
                      <%= event.isPublished ? 'Terbit' : 'Draf' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/events/<%= event.slug %>" target="_blank" class="btn-action" title="Lihat"><i data-lucide="eye" style="width: 14px; height: 14px;"></i></a>
                      <a href="/admin/events/<%= event.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Hapus agenda ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">Belum ada agenda yang dijadwalkan.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
