<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1"><%= pageTitle %></h3>
        <p class="text-muted small mb-0">Kelola program peminatan keilmuan dan jurusan siswa.</p>
      </div>
      <a href="/admin/programs/create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        <span>Tambah Program</span>
      </a>
    </div>

    <div class="admin-card">
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Gambar</th>
              <th>Nama Program</th>
              <th>Durasi</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (programs && programs.length > 0) { %>
              <% programs.forEach(function(prog) { %>
                <tr>
                  <td style="width: 70px;">
                    <div style="width: 60px; height: 44px; border-radius: 6px; overflow: hidden; background: #e2e8f0;">
                      <img src="<%= prog.imageUrl || 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= prog.name %></div>
                    <small class="text-muted"><%= prog.slug %></small>
                  </td>
                  <td><span class="badge bg-light text-primary"><%= prog.duration || '3 Tahun' %></span></td>
                  <td>
                    <span class="status-badge <%= prog.isActive ? 'active' : 'inactive' %>">
                      <%= prog.isActive ? 'Aktif' : 'Nonaktif' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/programs/<%= prog.id %>/edit" class="btn-action" title="Edit"><i data-lucide="edit-2" style="width: 14px; height: 14px;"></i></a>
                      <form action="/admin/programs/<%= prog.id %>/delete" method="POST" onsubmit="return confirm('Hapus program peminatan ini?');" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action delete" title="Hapus"><i data-lucide="trash" style="width: 14px; height: 14px;"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-muted py-4">Belum ada program peminatan.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination') %>
    </div>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
