<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Program Peminatan</h3>
        <p class="text-muted small mb-0">Rincian penjurusan akademik atau vokasi.</p>
      </div>
      <a href="/admin/programs" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/programs" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Program</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Nama Program <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="Contoh: Matematika & Ilmu Pengetahuan Alam (MIPA)" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Durasi Pendidikan</label>
                  <input type="text" name="duration" class="form-control" value="3 Tahun">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Foto / Banner Program</label>
                  <input type="file" name="image" class="form-control" accept="image/*">
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi Lengkap & Prospek Lulusan</label>
                <textarea name="description" rows="6" class="form-control" placeholder="Tuliskan tujuan peminatan, mata pelajaran khusus, dan prospek perguruan tinggi..."></textarea>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" checked>
                <label class="form-check-label fw-bold small" for="activeSwitch">Status Program Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Program</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
