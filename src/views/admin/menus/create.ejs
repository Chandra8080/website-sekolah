<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Menu Navigasi</h3>
        <p class="text-muted small mb-0">Tambahkan item navigasi induk atau sub-menu turunan.</p>
      </div>
      <a href="/admin/menus" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/menus" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Konfigurasi Menu</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Tampilan Menu <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="Contoh: Ekstrakurikuler" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Tautan / URL Tujuan <span class="text-danger">*</span></label>
                <input type="text" name="url" class="form-control" placeholder="Contoh: /academic/extracurriculars atau https://..." required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Menu Induk (Parent Menu)</label>
                  <select name="parentId" class="form-select">
                    <option value="">-- Menu Tingkat Utama (Root) --</option>
                    <% parentMenus.forEach(function(p) { %>
                      <option value="<%= p.id %>"><%= p.title %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Urutan Tampil</label>
                  <input type="number" name="sortOrder" class="form-control" value="0">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Target Jendela</label>
                  <select name="target" class="form-select">
                    <option value="_self">_self (Sama)</option>
                    <option value="_blank">_blank (Tab Baru)</option>
                  </select>
                </div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" checked>
                <label class="form-check-label fw-bold small" for="activeSwitch">Menu Aktif</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Menu Navigasi</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
