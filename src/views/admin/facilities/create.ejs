<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Tambah Fasilitas Baru</h3>
        <p class="text-muted small mb-0">Dokumentasikan sarana dan ruang pembelajaran sekolah.</p>
      </div>
      <a href="/admin/facilities" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/facilities" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Informasi Fasilitas</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Nama Fasilitas <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="Contoh: Laboratorium Komputer & AI" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Kategori</label>
                <input type="text" name="category" class="form-control" placeholder="Contoh: Laboratorium / Sarana Olahraga" value="Fasilitas Pembelajaran">
              </div>

              <div class="mb-3">
                <label class="form-label">Foto Fasilitas</label>
                <input type="file" name="image" class="form-control" accept="image/*">
              </div>

              <div class="mb-3">
                <label class="form-label">Deskripsi Fasilitas</label>
                <textarea name="description" rows="5" class="form-control" placeholder="Kapasitas, spesifikasi, dan kelengkapan alat..."></textarea>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" checked>
                <label class="form-check-label fw-bold small" for="activeSwitch">Status Aktif & Tampil di Web</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                <span>Simpan Fasilitas</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
