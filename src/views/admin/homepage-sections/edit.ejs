<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <%- include('../partials/admin-topbar') %>

  <div class="admin-content">
    <%- include('../partials/alert') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Sunting Bagian: <%= section.key %></h3>
        <p class="text-muted small mb-0"><%= section.title || 'Konfigurasi Konten' %></p>
      </div>
      <a href="/admin/homepage-sections" class="btn btn-outline-secondary btn-sm">&larr; Kembali ke Daftar</a>
    </div>

    <form action="/admin/homepage-sections/<%= section.id %>/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5>Konten Bagian</h5>
            </div>
            <div class="admin-card-body">
              <div class="mb-3">
                <label class="form-label">Judul Utama Bagian</label>
                <input type="text" name="title" class="form-control" value="<%= section.title || '' %>">
              </div>

              <div class="mb-3">
                <label class="form-label">Subjudul / Deskripsi Pendukung</label>
                <input type="text" name="subtitle" class="form-control" value="<%= section.subtitle || '' %>">
              </div>

              <div class="mb-3">
                <label class="form-label">Konten Teks Lengkap (Mendukung HTML)</label>
                <textarea name="content" rows="8" class="form-control"><%= section.content || '' %></textarea>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Foto / Gambar Pendukung</label>
                  <% if (section.imageUrl) { %>
                    <div class="mb-2 rounded overflow-hidden" style="max-height: 140px;">
                      <img src="<%= section.imageUrl %>" alt="" class="w-100 h-100" style="object-fit: cover;">
                    </div>
                  <% } %>
                  <input type="file" name="image" class="form-control" accept="image/*">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Urutan Tampil (Sort Order)</label>
                  <input type="number" name="sortOrder" class="form-control" value="<%= section.sortOrder %>">
                </div>
              </div>

              <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="activeSwitch" <%= section.isActive ? 'checked' : '' %>>
                <label class="form-check-label fw-bold small" for="activeSwitch">Tampilkan Bagian Ini di Beranda</label>
              </div>

              <button type="submit" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-1">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Perubahan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <%- include('../partials/admin-footer') %>
</div>
