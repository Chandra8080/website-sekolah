<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Agenda & Kegiatan</li>
      </ol>
    </nav>

    <div class="text-center mb-5">
      <span class="section-tag">Jadwal Aktivitas</span>
      <h1 class="fw-bold mb-2">Agenda Kegiatan Sekolah</h1>
      <p class="text-secondary max-w-600 mx-auto">Kalender acara, upacara, ujian, dan kompetisi di lingkungan sekolah.</p>
    </div>

    <!-- Tabs: Mendatang vs Telah Lewat -->
    <div class="d-flex justify-content-center mb-4">
      <div class="btn-group" role="group">
        <a href="/events?tab=upcoming" class="btn <%= tab === 'upcoming' ? 'btn-primary' : 'btn-outline-secondary' %>">Kegiatan Mendatang</a>
        <a href="/events?tab=past" class="btn <%= tab === 'past' ? 'btn-primary' : 'btn-outline-secondary' %>">Kegiatan Terdahulu</a>
      </div>
    </div>

    <% if (events && events.length > 0) { %>
      <div class="row g-4 justify-content-center">
        <% events.forEach(function(event) { %>
          <% const eventDate = new Date(event.startDate); %>
          <div class="col-lg-8">
            <div class="event-item-card">
              <div class="event-date-box">
                <div class="event-date-day"><%= eventDate.getDate() %></div>
                <div class="event-date-month"><%= eventDate.toLocaleString('id-ID', { month: 'short', year: 'numeric' }) %></div>
              </div>
              <div class="event-details">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge bg-light text-primary text-uppercase small"><%= event.status %></span>
                </div>
                <h4 class="fw-bold mb-2">
                  <a href="/events/<%= event.slug %>" class="text-dark text-decoration-none"><%= event.title %></a>
                </h4>
                <div class="text-muted small d-flex flex-wrap align-items-center gap-3 mb-2">
                  <span><i data-lucide="clock" style="width: 14px; height: 14px; display: inline-block;"></i> <%= event.startTime || '08:00' %> - <%= event.endTime || 'Selesai' %> WIB</span>
                  <span><i data-lucide="map-pin" style="width: 14px; height: 14px; display: inline-block;"></i> <%= event.location || 'Kampus Sekolah' %></span>
                </div>
                <p class="text-secondary small mb-3"><%= truncate(event.description, 120) %></p>
                <div>
                  <a href="/events/<%= event.slug %>" class="btn btn-outline-primary btn-sm">Lihat Detail Agenda &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <%- include('../../partials/pagination') %>
    <% } else { %>
      <div class="alert alert-light border text-center py-5">
        Tidak ada agenda kegiatan pada kategori ini.
      </div>
    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>
