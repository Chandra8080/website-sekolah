<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Prestasi</li>
      </ol>
    </nav>

    <div class="text-center mb-5">
      <span class="section-tag">Jejak Keunggulan</span>
      <h1 class="fw-bold mb-2">Prestasi & Penghargaan</h1>
      <p class="text-secondary max-w-600 mx-auto">Kiprah membanggakan siswa dan tenaga pendidik di kancah daerah, nasional, dan internasional.</p>
    </div>

    <!-- Filters & Search -->
    <div class="row g-3 align-items-center justify-content-between mb-4">
      <div class="col-md-7">
        <div class="d-flex flex-wrap gap-2">
          <a href="/achievements" class="btn btn-sm <%= !category && !level ? 'btn-primary' : 'btn-outline-secondary' %>">Semua</a>
          <a href="/achievements?category=akademik" class="btn btn-sm <%= category === 'akademik' ? 'btn-primary' : 'btn-outline-secondary' %>">Akademik</a>
          <a href="/achievements?category=non-akademik" class="btn btn-sm <%= category === 'non-akademik' ? 'btn-primary' : 'btn-outline-secondary' %>">Non-Akademik</a>
          <a href="/achievements?level=nasional" class="btn btn-sm <%= level === 'nasional' ? 'btn-primary' : 'btn-outline-secondary' %>">Nasional</a>
          <a href="/achievements?level=internasional" class="btn btn-sm <%= level === 'internasional' ? 'btn-primary' : 'btn-outline-secondary' %>">Internasional</a>
        </div>
      </div>
      <div class="col-md-4">
        <form action="/achievements" method="GET" class="d-flex gap-2">
          <input type="text" name="search" class="form-control" placeholder="Cari nama lomba atau siswa..." value="<%= search %>">
          <button type="submit" class="btn btn-primary d-inline-flex align-items-center">
            <i data-lucide="search" style="width: 16px; height: 16px;"></i>
          </button>
        </form>
      </div>
    </div>

    <% if (achievements && achievements.length > 0) { %>
      <div class="row g-4">
        <% achievements.forEach(function(ach) { %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 border rounded-3 shadow-sm overflow-hidden">
              <img src="<%= ach.imageUrl || 'https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b?q=80&w=500&auto=format&fit=crop' %>" class="card-img-top" alt="<%= ach.title %>" style="height: 180px; object-fit: cover;">
              <div class="card-body d-flex flex-column">
                <div class="d-flex gap-2 mb-2">
                  <span class="badge bg-warning text-dark text-uppercase small"><%= ach.level %></span>
                  <span class="badge bg-light text-secondary small"><%= ach.year || '2025' %></span>
                </div>
                <h5 class="card-title fw-bold fs-6 mb-2"><%= ach.title %></h5>
                <p class="card-text text-muted small flex-grow-1"><%= ach.description %></p>
                <div class="border-top pt-2 mt-2 text-muted small">
                  <i data-lucide="calendar" style="width: 12px; height: 12px; display: inline-block;"></i> <%= formatDate(ach.date) %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <%- include('../../partials/pagination') %>
    <% } else { %>
      <div class="alert alert-light border text-center py-5">
        Tidak ada data prestasi yang cocok dengan pencarian Anda.
      </div>
    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>
