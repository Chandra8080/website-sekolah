<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item"><a href="/academic">Akademik</a></li>
        <li class="breadcrumb-item active" aria-current="page">Program Peminatan</li>
      </ol>
    </nav>

    <div class="text-center mb-5">
      <span class="section-tag">Jalur Keilmuan</span>
      <h1 class="fw-bold mb-2">Program Peminatan & Keahlian</h1>
      <p class="text-secondary max-w-600 mx-auto">Dirancang untuk mengembangkan potensi spesifik peserta didik secara optimal.</p>
    </div>

    <% if (programs && programs.length > 0) { %>
      <div class="row g-4 justify-content-center">
        <% programs.forEach(function(prog) { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-3 shadow-sm overflow-hidden">
              <img src="<%= prog.imageUrl || 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=600&auto=format&fit=crop' %>" class="card-img-top" alt="<%= prog.name %>" style="height: 190px; object-fit: cover;">
              <div class="card-body d-flex flex-column">
                <div class="badge bg-light text-primary align-self-start mb-2"><%= prog.duration || '3 Tahun' %></div>
                <h4 class="card-title fw-bold fs-5 mb-2"><%= prog.name %></h4>
                <div class="card-text text-secondary small lh-base mb-3 flex-grow-1">
                  <%- prog.description %>
                </div>
                <a href="/ppdb" class="btn btn-outline-primary btn-sm mt-auto">Daftar Peminatan Ini &rarr;</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="alert alert-light border text-center py-5">
        Informasi program peminatan sedang diperbarui.
      </div>
    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>
