<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item">Profil</li>
        <li class="breadcrumb-item active" aria-current="page">Struktur Organisasi</li>
      </ol>
    </nav>

    <div class="text-center mb-5">
      <span class="section-tag">Tata Kelola Lembaga</span>
      <h1 class="fw-bold mb-2">Struktur Organisasi & Kepemimpinan</h1>
      <p class="text-secondary max-w-600 mx-auto">Mewujudkan tata kelola institusi yang transparan, profesional, dan akuntabel.</p>
    </div>

    <% if (structures && structures.length > 0) { %>
      <div class="row g-4 justify-content-center">
        <% structures.forEach(function(member) { %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 border rounded-3 text-center shadow-sm p-3">
              <div class="mx-auto mb-3" style="width: 120px; height: 120px; border-radius: 50%; overflow: hidden; border: 3px solid var(--color-primary-light);">
                <img src="<%= member.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop' %>" alt="<%= member.name %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <h6 class="fw-bold text-dark mb-1"><%= member.name %></h6>
              <div class="badge bg-light text-primary mb-2"><%= member.position %></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="alert alert-light border text-center py-5">
        Bagan struktur organisasi sedang dalam proses pembaruan data.
      </div>
    <% } %>
  </div>
</main>

<%- include('../../partials/footer') %>
