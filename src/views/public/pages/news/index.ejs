<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Berita & Informasi</li>
      </ol>
    </nav>

    <div class="row g-5">
      <!-- Main Content -->
      <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="fw-bold fs-2 mb-0"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Berita & Artikel Sekolah' %></h1>
          <% if (activeCategory) { %>
            <a href="/news" class="btn btn-sm btn-outline-secondary">Hapus Filter</a>
          <% } %>
        </div>

        <% if (newsList && newsList.length > 0) { %>
          <div class="row g-4">
            <% newsList.forEach(function(article) { %>
              <div class="col-md-6">
                <article class="editorial-card">
                  <div class="editorial-img-wrap">
                    <img src="<%= article.imageUrl || 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=600&auto=format&fit=crop' %>" alt="<%= article.title %>" loading="lazy">
                    <% if (article.category) { %>
                      <span class="editorial-badge"><%= article.category.name %></span>
                    <% } %>
                  </div>
                  <div class="editorial-body">
                    <div class="editorial-meta">
                      <span><i data-lucide="calendar" style="width: 14px; height: 14px; display: inline-block;"></i> <%= formatDate(article.publishedAt || article.createdAt) %></span>
                      <span>&bull;</span>
                      <span><i data-lucide="eye" style="width: 14px; height: 14px; display: inline-block;"></i> <%= article.viewCount %> tayang</span>
                    </div>
                    <h5 class="editorial-title">
                      <a href="/news/<%= article.slug %>"><%= article.title %></a>
                    </h5>
                    <p class="editorial-excerpt"><%= truncate(article.excerpt || article.content, 100) %></p>
                    <div class="editorial-footer">
                      <span class="text-muted"><%= article.author || 'Admin' %></span>
                      <a href="/news/<%= article.slug %>" class="text-primary d-inline-flex align-items-center gap-1">
                        <span>Baca Lengkap</span>
                        <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>

          <!-- Pagination -->
          <%- include('../../partials/pagination') %>
        <% } else { %>
          <div class="alert alert-light border text-center py-5">
            Tidak ada artikel atau berita yang ditemukan sesuai kriteria Anda.
          </div>
        <% } %>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <!-- Search Box -->
        <div class="card border rounded-3 p-4 shadow-sm mb-4">
          <h5 class="fw-bold mb-3">Cari Berita</h5>
          <form action="/news" method="GET">
            <div class="input-group">
              <input type="text" name="search" class="form-control" placeholder="Kata kunci..." value="<%= search %>">
              <button class="btn btn-primary" type="submit">
                <i data-lucide="search" style="width: 16px; height: 16px;"></i>
              </button>
            </div>
          </form>
        </div>

        <!-- Categories List -->
        <% if (categories && categories.length > 0) { %>
          <div class="card border rounded-3 p-4 shadow-sm mb-4">
            <h5 class="fw-bold mb-3">Kategori Artikel</h5>
            <div class="list-group list-group-flush">
              <a href="/news" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= !activeCategory ? 'fw-bold text-primary' : '' %>">
                <span>Semua Kategori</span>
              </a>
              <% categories.forEach(function(cat) { %>
                <a href="/news?category=<%= cat.slug %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= activeCategory && activeCategory.id === cat.id ? 'fw-bold text-primary' : '' %>">
                  <span><%= cat.name %></span>
                  <span class="badge bg-light text-dark rounded-pill"><%= cat._count.news %></span>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>

        <!-- Recent News Widget -->
        <% if (recentNews && recentNews.length > 0) { %>
          <div class="card border rounded-3 p-4 shadow-sm mb-4">
            <h5 class="fw-bold mb-3">Berita Terbaru Lainnya</h5>
            <div class="d-flex flex-column gap-3">
              <% recentNews.forEach(function(r) { %>
                <div class="d-flex gap-3 align-items-center">
                  <div style="width: 60px; height: 60px; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
                    <img src="<%= r.imageUrl || 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                  </div>
                  <div>
                    <h6 class="mb-1 small fw-bold">
                      <a href="/news/<%= r.slug %>" class="text-dark text-decoration-none"><%= truncate(r.title, 55) %></a>
                    </h6>
                    <small class="text-muted"><%= formatDate(r.publishedAt || r.createdAt) %></small>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
