<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item"><a href="/news">Berita</a></li>
        <li class="breadcrumb-item active text-truncate" style="max-width: 320px;" aria-current="page"><%= article.title %></li>
      </ol>
    </nav>

    <div class="row g-5">
      <div class="col-lg-8">
        <article class="bg-white p-4 p-md-5 border rounded-3 shadow-sm">
          <% if (article.category) { %>
            <div class="mb-3">
              <span class="badge bg-primary px-3 py-2 text-uppercase"><%= article.category.name %></span>
            </div>
          <% } %>

          <h1 class="fw-bold mb-3"><%= article.title %></h1>

          <div class="d-flex flex-wrap align-items-center gap-3 text-muted small pb-3 mb-4 border-bottom">
            <span><i data-lucide="user" style="width: 14px; height: 14px; display: inline-block;"></i> Ditulis oleh: <strong><%= article.author || 'Admin' %></strong></span>
            <span>&bull;</span>
            <span><i data-lucide="calendar" style="width: 14px; height: 14px; display: inline-block;"></i> <%= formatDate(article.publishedAt || article.createdAt) %></span>
            <span>&bull;</span>
            <span><i data-lucide="eye" style="width: 14px; height: 14px; display: inline-block;"></i> Dilihat <%= article.viewCount %> kali</span>
          </div>

          <% if (article.imageUrl) { %>
            <div class="mb-4 rounded-3 overflow-hidden" style="max-height: 440px;">
              <img src="<%= article.imageUrl %>" alt="<%= article.title %>" class="w-100 h-100" style="object-fit: cover;">
            </div>
          <% } %>

          <div class="article-content text-secondary lh-lg fs-5">
            <%- article.content %>
          </div>

          <!-- Social Share Bar -->
          <div class="mt-5 pt-4 border-top d-flex align-items-center justify-content-between">
            <span class="fw-bold small text-muted">Bagikan Artikel:</span>
            <div class="d-flex gap-2">
              <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(article.title + ' ' + currentUrl) %>" target="_blank" class="btn btn-sm btn-outline-success">WhatsApp</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(currentUrl) %>" target="_blank" class="btn btn-sm btn-outline-primary">Facebook</a>
              <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>&url=<%= encodeURIComponent(currentUrl) %>" target="_blank" class="btn btn-sm btn-outline-dark">Twitter/X</a>
            </div>
          </div>
        </article>
      </div>

      <!-- Related News Sidebar -->
      <div class="col-lg-4">
        <% if (relatedNews && relatedNews.length > 0) { %>
          <div class="card border rounded-3 p-4 shadow-sm mb-4">
            <h5 class="fw-bold mb-3">Berita Terkait</h5>
            <div class="d-flex flex-column gap-3">
              <% relatedNews.forEach(function(rel) { %>
                <div class="d-flex gap-3 align-items-center">
                  <div style="width: 70px; height: 70px; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
                    <img src="<%= rel.imageUrl || 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=200&auto=format&fit=crop' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                  </div>
                  <div>
                    <h6 class="mb-1 small fw-bold">
                      <a href="/news/<%= rel.slug %>" class="text-dark text-decoration-none"><%= truncate(rel.title, 55) %></a>
                    </h6>
                    <small class="text-muted"><%= formatDate(rel.publishedAt || rel.createdAt) %></small>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div class="card border rounded-3 p-4 shadow-sm bg-light">
          <h5 class="fw-bold mb-2">Penerimaan Siswa Baru</h5>
          <p class="small text-muted mb-3">Pendaftaran PPDB online telah dibuka untuk tahun ajaran baru.</p>
          <a href="/ppdb" class="btn btn-primary btn-sm">Buka Halaman PPDB</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
