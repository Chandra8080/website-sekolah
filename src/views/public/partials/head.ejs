<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? `${pageTitle} | ${settings.school_name || 'Sekolah'}` : (settings.school_name || 'School Information System') %></title>
  
  <meta name="description" content="<%= settings.meta_description || settings.school_description || 'Sistem Informasi Sekolah Terpadu' %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : settings.school_name %>">
  <meta property="og:description" content="<%= settings.meta_description || settings.school_description %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= currentUrl %>">

  <% if (settings.school_favicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= settings.school_favicon %>">
  <% } %>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Custom Design System CSS -->
  <link rel="stylesheet" href="/css/main.css">

  <!-- Dynamic Theme Color Injection from DB Settings -->
  <style>
    :root {
      <% if (settings.primary_color) { %>--color-primary: <%= settings.primary_color %>;<% } %>
      <% if (settings.color_primary_dark) { %>--color-primary-dark: <%= settings.color_primary_dark %>;<% } %>
      <% if (settings.secondary_color) { %>--color-secondary: <%= settings.secondary_color %>;<% } %>
      <% if (settings.color_secondary_dark) { %>--color-secondary-dark: <%= settings.color_secondary_dark %>;<% } %>
      <% if (settings.accent_color) { %>--color-accent: <%= settings.accent_color %>;<% } %>
    }
  </style>
</head>
<body>
