    {
      "id": 25,
      "key": "footer_text",
      "value": "SMA Negeri Nusantara berkomitmen menghadirkan pendidikan berkualitas tinggi untuk generasi penerus bangsa.",
      "type": "textarea",
      "group": "footer",
      "label": "Teks Footer",
