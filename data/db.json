  "teachers": [
    {
      "id": 1,
      "name": "Dr. H. Ahmad Fauzi, M.Pd.",
      "nip": "196801011990021001",
      "position": "Kepala Sekolah",
      "subject": null,
      "education": "S3 Manajemen Pendidikan",
      "photo": null,
      "bio": "Dengan pengalaman lebih dari 30 tahun di dunia pendidikan, beliau membawa visi besar untuk menjadikan SMA Negeri Nusantara sebagai sekolah rujukan nasional.",
      "email": "kepala@sekolah.sch.id",
      "category": "kepala_sekolah",
      "isActive": true,
      "sortOrder": 1,
      "isPublished": true,
      "isHeadmaster": true,
      "greetingText": "Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\nSalam sejahtera untuk seluruh warga sekolah, orang tua, dan masyarakat yang kami hormati.\n\nSebagai kepala SMA Negeri Nusantara, saya menyambut dengan hangat kunjungan Anda ke situs resmi sekolah kami. Website ini hadir sebagai jembatan informasi antara sekolah dengan seluruh pemangku kepentingan.\n\nSMA Negeri Nusantara berkomitmen untuk terus meningkatkan kualitas pendidikan yang berorientasi pada pengembangan karakter, kompetensi akademik, dan kesiapan menghadapi tantangan global. Kami percaya bahwa setiap siswa memiliki potensi yang luar biasa yang harus dipupuk dengan pendidikan yang tepat dan lingkungan yang kondusif.\n\nMari bersama-sama kita wujudkan generasi muda Indonesia yang cerdas, berkarakter, dan berdaya saing tinggi.\n\nWassalamu'alaikum Warahmatullahi Wabarakatuh.",
      "createdAt": "2026-11-08T10:59:52.358Z",
